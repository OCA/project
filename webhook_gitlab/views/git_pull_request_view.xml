<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model='ir.ui.view' id='git_pull_request_tree'>
        <field name='name'>git.pull.request.tree</field>
        <field name='model'>git.pull.request</field>
        <field name='arch' type='xml'>
            <tree
                decoration-danger="ci_status=='failed'"
                decoration-info="ci_status=='pending'"
                decoration-success="ci_status=='success'"
                decoration-muted="ci_status in ['skipped', 'canceled']"
                decoration-primary="ci_status=='running'"
            >
                <field name="id_request" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="source_branch" optional="show"/>
                <field name="name" optional="show"/>
                <field name="wip" optional="hide"/>
                <field name="approved" optional="hide"/>
                <field name="state" optional="show"/>
                <field name="ci_status" optional="show"/>
                <field name="url" optional="hide"/>
                <field name="task_id" optional="hide"/>
                <button name="open_merge_request" icon="fa-external-link" string="Open PR/MR" type="object" />
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='git_pull_request_form'>
        <field name='name'>git.pull.request.form</field>
        <field name='model'>git.pull.request</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="url" readonly="1" widget="url"/>
                            <field name="source" readonly="1"/>
                            <field name="task_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="id_request" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="source_branch" readonly="1"/>
                            <field name="target_branch" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="ci_status" readonly="1"/>
                            <field name="wip" readonly="1"/>
                            <field name="approved" readonly="1"/>
                            <field name="last_commit" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commits">
                            <field name="git_commit_ids" string="Commits">
                                <tree>
                                    <field name="name" optional="show"/>
                                    <field name="description" optional="show"/>
                                    <field name="url" optional="show" widget="url"/>
                                    <field name="sha" optional="hide"/>
                                    <field name="full_sha" optional="hide"/>
                                    <field name="git_branch_id" optional="hide"/>
                                    <field name="task_id" optional="hide"/>
                                    <field name="timestamp" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
