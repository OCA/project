<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model='ir.ui.view' id='git_commit_tree'>
        <field name='name'>git.commit.tree</field>
        <field name='model'>git.commit</field>
        <field name='arch' type='xml'>
            <tree>
                <field name="name" optional="show"/>
                <field name="description" optional="show"/>
                <field name="url" optional="show" widget="url"/>
                <field name="sha" optional="hide"/>
                <field name="full_sha" optional="hide"/>
                <field name="git_branch_ids" widget="many2many_tags" optional="hide"/>
                <field name="task_ids" widget="many2many_tags" optional="hide"/>
                <field name="timestamp" optional="hide"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='git_commit_form'>
        <field name='name'>git.commit.form</field>
        <field name='model'>git.commit</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="url" readonly="1" widget="url"/>
                            <field name="sha" readonly="1"/>
                            <field name="full_sha" readonly="1"/>
                            <field name="git_branch_ids" widget="many2many_tags" readonly="1"/>
                            <field name="git_pull_request_ids" widget="many2many_tags" readonly="1"/>
                            <field name="task_ids" widget="many2many_tags" readonly="1"/>
                            <field name="timestamp" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
