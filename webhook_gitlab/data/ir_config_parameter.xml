<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="gitlab_token" model="ir.config_parameter">
            <field name="key">webhook_gitlab.authorization_token</field>
            <field name="value">token</field>
        </record>
        <record id="gitlab_private_token" model="ir.config_parameter">
            <field
                name="key"
            >webhook_gitlab.gitlab_token.https://gitlab.example.com/</field>
            <field name="value">token</field>
        </record>
    </data>

    <function model="git.utils" name="_init_task_name_match_regex_param" />
</odoo>
