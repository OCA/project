<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.progress</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="type">form</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="manual_progress" />
            </field>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.list.progress</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="type">list</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="before">
                <field
                    name="manual_progress"
                    widget="progressbar"
                    avg="Average of Progress"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="view_task_kanban" model="ir.ui.view">
        <field name="name">project.task.kanban.progress</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="manual_progress" widget="progressbar" />
            </field>
        </field>
    </record>
</odoo>
