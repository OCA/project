<odoo>
  <record id="project_task_view_form_inherit_scoped_tags" model="ir.ui.view">
    <field name="name">project.task.form.inherit.scoped.tags</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']" position="attributes">
        <attribute
                    name="domain"
                >['|', '|', ('globally_available', '=', True), ('project_ids', 'in', [project_id]), ('available_in_project_ids', 'in', [project_id])]</attribute>
        <attribute
                    name="context"
                >{'default_available_in_project_ids': [project_id]}</attribute>
      </xpath>
    </field>
  </record>
</odoo>
