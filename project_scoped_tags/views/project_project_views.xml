<odoo>
  <record id="project_project_view_form_inherit_scoped_tags" model="ir.ui.view">
    <field name="name">project.project.form.inherit.scoped.tags</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']" position="attributes">
        <attribute
                    name="domain"
                >['|', ('available_in_project_ids', '=', False), ('available_in_project_ids', 'in', [id])]</attribute>
        <attribute name="context">{'default_available_in_project_ids': [id]}</attribute>
      </xpath>
    </field>
  </record>
</odoo>
