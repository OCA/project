<odoo>
    <record id="edit_project_inherit" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="notification_manager" string="Manage notifications">
                    <group>
                        <group string="Thresholds">
                            <field name="costs_threshold" widget="percentage" />
                        </group>
                        <group string="Notifications">
                            <field name="force_notification_send_cost_threshold" />
                            <field name="create_activity" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
