<odoo>
    <record
        id="product_template_form_view_inherit_sale_project_reuse"
        model="ir.ui.view"
    >
        <field name="name">product.template.form.inherit.sale.project.reuse</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_template_id']" position="after">
                <field name="reuse_project_visible" invisible="1" />
                <div
                    class="o_td_label d-inline-flex"
                    invisible="not reuse_project_visible"
                >
                    <label for="reuse_project" />
                </div>
                <field
                    name="reuse_project"
                    invisible="not reuse_project_visible"
                    nolabel="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
