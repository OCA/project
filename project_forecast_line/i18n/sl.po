#. module: project_forecast_line
#: model:ir.model.fields,help:project_forecast_line.field_project_task__display_name
msgid ""
"Use these keywords in the title to set new tasks:\n"
"\n"
"        30h Allocate 30 hours to the task\n"
"        #tags Set tags on the task\n"
"        @user Assign the task to a user\n"
"        ! Set the task a high priority\n"
"\n"
"        Make sure to use the right format and order e.g. Improve the configuration screen 5h #feature #v16 @Mitchell !"
msgstr ""
"Uporabite te ključne besede v naslovu za nastavitev novih opravil:\n"
"\n"
"        30h Opravilu dodeli 30 ur\n"
"        #oznake Nastavi oznake na opravilu\n"
"        @uporabnik Dodeli opravilo uporabniku\n"
"        ! Nastavi opravilu visoko prioriteto\n"
"\n"
"        Uporabite pravilno obliko in vrstni red, npr. Izboljšaj nastavitveni "
"zaslon 5h #funkcija #v16 @Mitchell !"

