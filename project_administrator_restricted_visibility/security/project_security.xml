<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Rename old 'Project Administrator' access group name. Its project and
    task visibility is restricted in ir.access.csv -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="name">Restricted Administrator</field>
    </record>
    <!-- Create a new 'Project Administrator' access group that is not affected
    by those restrictions -->
    <record id="group_full_project_manager" model="res.groups">
        <field name="name">Full Administrator</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project" />
        <field name="implied_ids" eval="[(4, ref('project.group_project_manager'))]" />
    </record>
</odoo>
