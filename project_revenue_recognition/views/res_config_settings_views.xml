<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Revenue Recognition" id="project_revenue_recognition">
                    <setting
                        id="revenue_recognition_accounts"
                        string="Revenue Recognition Accounts"
                        company_dependent="1"
                        help="Set the default accounts used to record project revenue and expenses for revenue recognition."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    string="Accrued Revenue Account"
                                    for="project_accrued_revenue_account_id"
                                    class="col-lg-6 o_light_label"
                                />
                                <field name="project_accrued_revenue_account_id" />
                            </div>
                            <div class="row">
                                <label
                                    string="Deferred Revenue Account"
                                    for="project_deferred_revenue_account_id"
                                    class="col-lg-6 o_light_label"
                                />
                                <field name="project_deferred_revenue_account_id" />
                            </div>
                            <div class="row">
                                <label
                                    string="Revenue Account"
                                    for="project_revenue_account_id"
                                    class="col-lg-6 o_light_label"
                                />
                                <field name="project_revenue_account_id" />
                            </div>
                            <div class="row">
                                <label
                                    string="Journal"
                                    for="project_revenue_recognition_journal_id"
                                    class="col-lg-6 o_light_label"
                                />
                                <field
                                    name="project_revenue_recognition_journal_id"
                                    domain="[('type', '=', 'general')]"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
