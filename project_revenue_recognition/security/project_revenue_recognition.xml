<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_revenue_recognition_rule" model="ir.rule">
        <field name="name">Project Revenue Recognition multi company rule</field>
        <field name="model_id" ref="model_project_revenue_recognition" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="project_revenue_recognition_line_rule" model="ir.rule">
        <field name="name">Project Revenue Recognition Line multi company rule</field>
        <field name="model_id" ref="model_project_revenue_recognition_line" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
