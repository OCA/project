<odoo>
    <record id="project_project_view_form_inherit_stage_order" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.stage.order</field>
        <field name="model">project.project</field>
        <field
            name="inherit_id"
            ref="project_task_stage_mgmt.project_project_view_form_inherit_stages"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_ids']" position="attributes">
                <attribute name="invisible">task_stage_order_enabled</attribute>
            </xpath>
            <xpath expr="//field[@name='type_ids']" position="after">
                <field name="task_stage_order_enabled" invisible="1" />
                <field
                    name="task_stage_order_ids"
                    invisible="not task_stage_order_enabled"
                    domain="[('stage_id.active', '=', True)]"
                >
                    <list editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="stage_id" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="task_type_tree_inherited_flat" model="ir.ui.view">
        <field name="name">project.task.type.list.flat</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_tree_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_group_by" />
            </xpath>
        </field>
    </record>
</odoo>
