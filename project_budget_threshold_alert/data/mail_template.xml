<odoo>
    <record id="project_budget_exceeded_email_template" model="mail.template">
        <field name="name">Project: Budget threashold exceeded</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="subject">{{ object.name }}: Budget Threashold Exceeded</field>
        <field
            name="description"
        >Automated notification sent to the project subscribers to inform about project budget
            threshold exceeding
        </field>
        <field name="body_html" type="html">
            <p>Hello,</p>
            <br />
            <p>
                This is an automated notification to inform you that the budget threshold for the project
                <strong>
                <t t-out="object.name" />
            </strong> has been exceeded.
            </p>
            <ul>
                <li>
                    <strong>Budget: </strong>
                    <t t-out="object.total_budget_amount" />
                </li>
                <li>
                    <strong>Threshold reached: </strong>
                    <t t-out="object.budget_threshold" />%
                </li>
            </ul>

            <p>
                Please review the project budget and take any necessary actions.
            </p>

            <p>
                Best regards,
                <br />
                <t t-out="object.company_id.name" />
            </p>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
    </record>
</odoo>
