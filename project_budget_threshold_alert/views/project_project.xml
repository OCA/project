<odoo>
    <record id="edit_project_inherit" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="notification_manager" string="Manage notifications">
                    <group>
                        <group>
                            <field name="budget_threshold" widget="percentage" />
                            <field
                                name="total_budget_amount_threshold"
                                widget='monetary'
                                invisible="not total_budget_amount or not budget_threshold"
                            />
                            <field name="force_notification_send" />
                            <field name="create_activity_for_project_manager" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
