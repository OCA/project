<odoo>

    <record id="project_buttom_kanban_view" model="ir.ui.view">
        <field name="name">project.project.kanban</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//span[hasclass('o_text_overflow')]" position="after">
                <a type="edit" groups="project.group_project_manager">
                    <span class="o_text_overflow" style="font-size: 16px;"><t
                            t-out="record.display_name.value"
                        /></span>
                </a>
            </xpath>
            <xpath expr="//span[hasclass('o_text_overflow')]" position="attributes">
                <attribute name="groups">!project.group_project_manager</attribute>
            </xpath>
        </field>
    </record>

</odoo>
