<odoo>
    <record model="ir.ui.view" id="project_collaborator_search_view">
        <field name="model">project.collaborator</field>
        <field name="inherit_id" ref="project.project_collaborator_view_search" />
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <separator />
                <filter
                    name="readonly"
                    string="Read-Only"
                    domain="[('readonly', '=', True)]"
                />
                <filter
                    name="readwrite"
                    string="Read-Write"
                    domain="[('readonly', '=', False)]"
                />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="project_collaborator_tree_view">
        <field name="model">project.collaborator</field>
        <field name="inherit_id" ref="project.project_sharing_access_view_tree" />
        <field name="arch" type="xml">
            <field name="partner_email" position="after">
                <field name="readonly" widget="boolean_toggle" />
            </field>
        </field>
    </record>
</odoo>
