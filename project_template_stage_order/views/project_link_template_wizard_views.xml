<odoo>
    <record id="project_link_template_wizard_view_form" model="ir.ui.view">
        <field name="name">project.link.template.wizard.form</field>
        <field name="model">project.link.template.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="project_id" invisible="1" />
                <field name="state" invisible="1" />
                <group invisible="state != 'select'">
                    <field
                        name="template_id"
                        string="Project"
                        domain="[('template_id', '=', False), ('id', '!=', project_id)]"
                    />
                </group>
                <group invisible="state != 'confirm'">
                    <field name="child_order_display" />
                    <field name="parent_order_display" />
                </group>
                <footer>
                    <button
                        string="Check"
                        type="object"
                        name="action_check"
                        class="btn-primary"
                        invisible="state != 'select'"
                    />
                    <button
                        string="Confirm Link"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                        invisible="state != 'confirm'"
                        confirm="The current project's stage order will be replaced with the selected project's order. Continue?"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
