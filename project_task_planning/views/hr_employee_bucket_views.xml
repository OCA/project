<odoo>
    <record id="view_hr_employee_bucket_form" model="ir.ui.view">
        <field name="name">hr.employee.bucket.form</field>
        <field name="model">hr.employee.bucket</field>
        <field name="arch" type="xml">
            <form string="Employee Bucket" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id" />
                        </group>
                        <group string="Period">
                            <field name="bucket" readonly="1" />
                            <field
                                name="date_start"
                                widget="daterange"
                                options="{'end_date_field': 'date_end'}"
                                string="Dates"
                            />
                            <field name="date_end" invisible="1" />
                        </group>
                    </group>
                    <group string="Hours Overview">
                        <group>
                            <field
                                name="working_hours"
                                widget="float_time"
                                string="Capacity Hours"
                            />
                            <field name="planned_hours" widget="float_time" />
                            <field name="remaining_hours" widget="float_time" />
                            <field name="utilization_rate" />
                            <field
                                name="planning_status"
                                widget="badge"
                                decoration-success="planning_status == 'optimal'"
                                decoration-warning="planning_status == 'underplanned'"
                                decoration-danger="planning_status == 'overplanned'"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Planned Hours Details" name="planned_details">
                            <field name="task_planning_ids">
                                <list>
                                    <field name="project_id" />
                                    <field name="task_id" />
                                    <field
                                        name="planned_hours"
                                        widget="float_time"
                                        sum="Total Planned"
                                    />
                                    <field name="blocked" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_bucket_list" model="ir.ui.view">
        <field name="name">hr.employee.bucket.list</field>
        <field name="model">hr.employee.bucket</field>
        <field name="arch" type="xml">
            <list edit="false" create="false">
                <field name="employee_id" />
                <field name="bucket" readonly="1" />
                <field
                    name="date_start"
                    widget="daterange"
                    options="{'end_date_field': 'date_end'}"
                    string="Dates"
                    optional="show"
                />
                <field name="date_end" column_invisible="True" />
                <field name="working_hours" widget="float_time" sum="Total Capacity" />
                <field name="planned_hours" widget="float_time" sum="Total Planned" />
                <field
                    name="remaining_hours"
                    widget="float_time"
                    sum="Total Remaining"
                />
                <field name="utilization_rate" />
                <field
                    name="planning_status"
                    widget="badge"
                    decoration-success="planning_status == 'optimal'"
                    decoration-warning="planning_status == 'underplanned'"
                    decoration-danger="planning_status == 'overplanned'"
                />
            </list>
        </field>
    </record>

    <record id="view_hr_employee_bucket_pivot" model="ir.ui.view">
        <field name="name">hr.employee.bucket.pivot</field>
        <field name="model">hr.employee.bucket</field>
        <field name="arch" type="xml">
            <pivot string="Employee Bucket Analysis" sample="1">
                <field name="employee_id" type="row" />
                <field name="bucket" type="col" />
                <field name="working_hours" type="measure" />
                <field name="planned_hours" type="measure" />
                <field name="remaining_hours" type="measure" />
                <field name="utilization_rate" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="search_hr_employee_bucket" model="ir.ui.view">
        <field name="name">hr.employee.bucket.search</field>
        <field name="model">hr.employee.bucket</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="bucket" />
                <separator />
                <filter
                    string="Current Period"
                    name="current_period"
                    domain="[('date_start', '&lt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Over-planned"
                    name="over_planned"
                    domain="[('remaining_hours', '&lt;', 0)]"
                />
                <separator />
                <filter
                    string="Employee"
                    name="group_by_employee"
                    context="{'group_by': 'employee_id'}"
                />
                <filter
                    string="Bucket"
                    name="group_by_bucket"
                    context="{'group_by': 'bucket'}"
                />
            </search>
        </field>
    </record>

    <record id="action_hr_employee_bucket" model="ir.actions.act_window">
        <field name="name">Employee Buckets</field>
        <field name="res_model">hr.employee.bucket</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="search_view_id" ref="search_hr_employee_bucket" />
        <field
            name="context"
        >{'pivot_row_groupby': ['employee_id'], 'pivot_column_groupby': ['bucket'], 'pivot_measures': ['working_hours', 'planned_hours', 'remaining_hours']}</field>
    </record>

    <menuitem
        name="Employee Buckets"
        sequence="26"
        parent="project.menu_project_report"
        id="action_hr_employee_bucket_menu"
        action="action_hr_employee_bucket"
    />

    <!-- Planning main menu under Proyecto app (sequence 3, after Tasks sequence 2) -->
    <menuitem
        id="menu_project_planning"
        name="Planning"
        parent="project.menu_main_pm"
        sequence="3"
    />

    <!-- My Planning sub-menu -->
    <record id="action_my_planning" model="ir.actions.act_window">
        <field name="name">My Planning</field>
        <field name="res_model">hr.employee.bucket</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="search_hr_employee_bucket" />
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_period': 1}</field>
    </record>

    <menuitem
        id="menu_project_planning_my"
        name="My Planning"
        parent="menu_project_planning"
        sequence="10"
        action="action_my_planning"
    />

    <!-- Employee Buckets sub-menu -->
    <menuitem
        id="menu_project_planning_employee_buckets"
        name="Employee Buckets"
        parent="menu_project_planning"
        sequence="20"
        action="action_hr_employee_bucket"
    />

    <!-- Task Planning sub-menu -->
    <menuitem
        id="menu_project_planning_task_planning"
        name="Task Planning"
        parent="menu_project_planning"
        sequence="30"
        action="action_project_task_planning"
    />

    <!-- Task Allocations sub-menu -->
    <menuitem
        id="menu_project_planning_task_allocation"
        name="Task Allocations"
        parent="menu_project_planning"
        sequence="40"
        action="action_project_task_allocation_pivot"
    />
</odoo>
