<odoo>
    <record id="view_project_task_planning_form" model="ir.ui.view">
        <field name="name">project.task.planning.form</field>
        <field name="model">project.task.planning</field>
        <field name="arch" type="xml">
            <form string="Task Planning">
                <sheet>
                    <group>
                        <group string="Planning Info">
                            <field name="allocation_id" />
                            <field name="project_id" />
                            <field name="task_id" />
                            <field name="employee_id" />
                        </group>
                        <group string="Period &amp; Hours">
                            <field name="bucket" readonly="1" />
                            <field
                                name="date_start"
                                widget="daterange"
                                options="{'end_date_field': 'date_end'}"
                                readonly="blocked"
                                force_save="1"
                                string="Planning Dates"
                            />
                            <field name="date_end" invisible="1" />
                            <field
                                name="planned_hours"
                                widget="float_time"
                                readonly="blocked"
                                force_save="1"
                            />
                            <field name="blocked" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_task_planning_list" model="ir.ui.view">
        <field name="name">project.task.planning.list</field>
        <field name="model">project.task.planning</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="blocked" />
                <field name="project_id" />
                <field name="task_id" />
                <field name="employee_id" />
                <field name="bucket" readonly="1" />
                <field
                    name="date_start"
                    widget="daterange"
                    options="{'end_date_field': 'date_end'}"
                    readonly="blocked"
                    force_save="1"
                    string="Planning Dates"
                    optional="hide"
                />
                <field name="date_end" column_invisible="True" />
                <field
                    name="planned_hours"
                    widget="float_time"
                    readonly="blocked"
                    force_save="1"
                />
            </list>
        </field>
    </record>

    <record id="view_project_task_planning_pivot" model="ir.ui.view">
        <field name="name">project.task.planning.pivot</field>
        <field name="model">project.task.planning</field>
        <field name="arch" type="xml">
            <pivot string="Planning Analysis" sample="1">
                <field name="bucket" type="row" />
                <field name="employee_id" type="col" />
                <field name="planned_hours" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="search_project_task_planning" model="ir.ui.view">
        <field name="name">project.task.planning.search</field>
        <field name="model">project.task.planning</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="project_id" />
                <field name="task_id" />
                <field name="bucket" />
                <separator />
                <filter
                    string="Blocked"
                    name="filter_blocked"
                    domain="[('blocked', '=', True)]"
                />
                <filter
                    string="Active/Unblocked"
                    name="filter_active"
                    domain="[('blocked', '=', False)]"
                />
                <separator />
                <filter
                    string="Project"
                    name="group_by_project"
                    context="{'group_by': 'project_id'}"
                />
                <filter
                    string="Task"
                    name="group_by_task"
                    context="{'group_by': 'task_id'}"
                />
                <filter
                    string="Employee"
                    name="group_by_employee"
                    context="{'group_by': 'employee_id'}"
                />
                <filter
                    string="Planning Bucket"
                    name="group_by_bucket"
                    context="{'group_by': 'bucket'}"
                />
            </search>
        </field>
    </record>

    <record id="action_project_task_planning" model="ir.actions.act_window">
        <field name="name">Task Planning</field>
        <field name="res_model">project.task.planning</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="search_view_id" ref="search_project_task_planning" />
        <field
            name="context"
        >{'pivot_row_groupby': ['bucket'], 'pivot_column_groupby': ['employee_id'], 'pivot_measures': ['planned_hours']}</field>
    </record>

    <menuitem
        name="Task Planning"
        sequence="25"
        parent="project.menu_project_report"
        id="action_project_task_planning_menu"
        action="action_project_task_planning"
    />
</odoo>
