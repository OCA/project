<odoo>
    <record model="ir.ui.view" id="view_recurring_activity_form">
        <field name="name">project_task_recurring_activity_form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <div groups="project.group_project_recurring_tasks">
                    <button
                        string="Create Next Recurring Task"
                        class="oe_highlight"
                        groups="base.group_no_one"
                        name="call_create_recurring_tasks"
                        type="object"
                        invisible="not recurring_task"
                    />
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="recurring_activities"
                    string="Activities"
                    groups="project.group_project_recurring_tasks"
                    invisible="not recurring_task"
                >
                    <field name="recurring_activity_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="user_id" />
                            <field name="project_task_id" column_invisible="True" />
                            <field name="activity_type_id" />
                            <field name="summary" />
                            <field name="description" />
                            <field name="days_after_task_creation_date" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
