#. module: project_no_portal
#. odoo-python
#: code:addons/project_no_portal/models/project_project.py:0
msgid ""
"Portal visibility is disabled for company %(company)s: portal users can not "
"access its projects or tasks."
msgstr ""
"Die Sichtbarkeit des Portals ist für das Unternehmen %(company) deaktiviert: "
"Portalbenutzer können nicht auf dessen Projekte oder Aufgaben zugreifen."

#. module: project_no_portal
#: model_terms:ir.ui.view,arch_db:project_no_portal.res_config_settings_view_form
msgid ""
"Prevent portal users from reading projects and tasks, block portal "
"visibility, and disable the share actions."
msgstr ""
"Verhindern Sie, dass Portalbenutzer Projekte und Aufgaben einsehen können, "
"sperren Sie die Sichtbarkeit im Portal und deaktivieren Sie die "
"Freigabefunktionen."

#. module: project_no_portal
#: model:ir.model,name:project_no_portal.model_project_project
msgid "Project"
msgstr "Projekt"

#. module: project_no_portal
#. odoo-python
#: code:addons/project_no_portal/models/portal_share.py:0
#: code:addons/project_no_portal/models/project_project.py:0
msgid ""
"Sharing is disabled for company %(company)s: portal users can not access its"
" projects or tasks. An administrator can allow it in Settings > Project."
msgstr ""
"Die Freigabe ist für das Unternehmen %(company) deaktiviert: Portalbenutzer "
"können nicht auf dessen Projekte oder Aufgaben zugreifen. Ein Administrator "
"kann dies unter „Einstellungen > Projekt“ aktivieren."

