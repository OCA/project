<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_production_lot_form_inherit_tasks" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.tasks</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_tasks"
                    type="object"
                    icon="fa-tasks"
                    class="oe_stat_button"
                    invisible="task_count == 0"
                >
                    <field name="task_count" widget="statinfo" string="Tasks" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
